# Node.js: copy this file to .env; npm start loads it automatically when present.
# Existing environment variables take precedence over .env.
# Cloudflare Pages: configure variables/secrets in the project settings.
PORT=3000

# Leave empty for automatic selection: Upstash when both credentials exist,
# otherwise memory. Use upstash on Cloudflare and with multiple instances.
STORE_KIND=memory
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# auto detects Ollama on port 11434 or host "ollama".
# Use ollama explicitly for a local proxy on another port; openrouter for cloud.
AI_PROVIDER=auto
# Optional for Ollama; required for OpenRouter. Built-in rules need no key.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Models for all tasks are fixed in shared/config.js:
# OpenRouter: nvidia/nemotron-3.5-super-vl:free; Ollama: gemma4:e2b.
