# Node.js: export these variables in your shell before npm start.
# Cloudflare Pages: configure variables/secrets in the project settings.
PORT=3000

# Leave empty for automatic selection: Upstash when both credentials exist,
# otherwise memory. Use upstash on Cloudflare and with multiple instances.
STORE_KIND=memory
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: built-in game rules work without an API key.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MODEL=nvidia/nemotron-3.5-super-vl:free

# Optional hint model override; falls back to MODEL when empty.
MODEL_HINT=
# Optional analysis model override; falls back to MODEL when empty.
MODEL_ANALYSIS=
# Optional drawing model override; must accept image inputs. Falls back to MODEL.
MODEL_VISION=
